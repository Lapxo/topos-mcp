bound-lock/1 about="name: release\non:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\n    inputs:\n      publish:\n        description: Publish the existing draft only after owner approval\n        type: boolean\n        default: false\npermissions:\n  contents: read\nconcurrency:\n  group: release-${{ github.ref }}\n  cancel-in-progress: false\njobs:\n  verify:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        node: [22, 24]\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n      - run: npm ci --ignore-scripts\n      - run: npm run build\n      - run: node --test test/prior-vectors.test.ts test/response-fields.test.ts\n      - name: Verify admitted producer obligations\n        env:\n          INSTRUMENT: ${{ runner.temp }}/topos-mcp-bound\n        run: |\n          npm install --prefix \"$INSTRUMENT\" --no-save --ignore-scripts --no-audit --no-fund @lapxo/bound@0.2.8\n          node \"$INSTRUMENT/node_modules/@lapxo/bound/dist/cli/verb.js\" fold --check\n      - name: Verify the exact delivery\n        run: |\n          set -euo pipefail\n          printf '%s  %s\\n' '1c3c9326e89aabe3a43bf074d0e06b5bbebd1fdb6e06423b957dc03914de051d' 'delivery/1c3c9326e89aabe3a43bf074d0e06b5bbebd1fdb6e06423b957dc03914de051d.tar.gz' | sha256sum -c -\n          printf '%s  %s\\n' 'c472ae2856813c7e8cbc3dbd7e96884aa2e769dd5fa277fcb21d7061a81dda3e' 'delivery/standing.bound' | sha256sum -c -\n          node --input-type=module <<'NODE'\n          import { readFileSync } from 'node:fs';\n          import { strict as assert } from 'node:assert';\n          import { toposStanding } from '@lapxo/topos/standing';\n          const manifest = JSON.parse(readFileSync('delivery/release.json'));\n          assert.equal(manifest.version, JSON.parse(readFileSync('package.json')).version);\n          assert.equal(manifest.capsule, 'sha256:1c3c9326e89aabe3a43bf074d0e06b5bbebd1fdb6e06423b957dc03914de051d');\n          assert.equal(manifest.standing, 'sha256:c472ae2856813c7e8cbc3dbd7e96884aa2e769dd5fa277fcb21d7061a81dda3e');\n          assert.equal(toposStanding(readFileSync('TARGET.bound', 'utf8').trim().split('\\n')), readFileSync('delivery/standing.bound', 'utf8'));\n          NODE\n  publish:\n    needs: verify\n    if: github.event_name == 'workflow_dispatch' && inputs.publish && github.ref == 'refs/heads/main'\n    environment: release\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n      - run: npm install --prefix .instrument --no-save --ignore-scripts --no-audit --no-fund @lapxo/bound@0.2.8\n      - name: Publish only the owner-approved existing assets\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          tag=\"v$(node -p \"require('./package.json').version\")\"\n          archive='1c3c9326e89aabe3a43bf074d0e06b5bbebd1fdb6e06423b957dc03914de051d.tar.gz'\n          digest='sha256:1c3c9326e89aabe3a43bf074d0e06b5bbebd1fdb6e06423b957dc03914de051d'\n          test \"$(git rev-parse HEAD)\" = \"$(git rev-list -n 1 \"$tag\")\"\n          test \"$(gh release view \"$tag\" --json isDraft --jq .isDraft)\" = true\n          stage=\"$(mktemp -d \"$RUNNER_TEMP/topos-mcp-release.XXXXXX\")\"\n          trap 'rm -rf \"$stage\"' EXIT\n          gh release download \"$tag\" --pattern approval-signed --dir \"$stage\"\n          node .instrument/node_modules/@lapxo/bound/dist/cli/verb.js fold --as release \"$stage/approval-signed\" > \"$stage/verdict\"\n          read -r status approved artifact source extra < \"$stage/verdict\"\n          test \"$status\" = READY\n          test -z \"$extra\"\n          test \"$approved\" = \"$digest\"\n          test \"$artifact\" = \"$archive\"\n          test \"$source\" = \"https://github.com/$GITHUB_REPOSITORY/releases/download/$tag/$archive\"\n          for asset in \"$archive\" standing.bound release.json; do\n            gh release download \"$tag\" --pattern \"$asset\" --dir \"$stage\"\n            cmp \"delivery/$asset\" \"$stage/$asset\"\n          done\n          printf '%s  %s\\n' \"${digest#sha256:}\" \"$stage/$archive\" | sha256sum -c -\n          printf '%s  %s\\n' 'c472ae2856813c7e8cbc3dbd7e96884aa2e769dd5fa277fcb21d7061a81dda3e' \"$stage/standing.bound\" | sha256sum -c -\n          gh release edit \"$tag\" --draft=false\n" at=policy:mcp/ci-native-obligations/0.1.2 by=target form=alphabet measure=text role=writes scope=prose/en/pipeline/release shape=.github/workflows/release.yml value=lock
