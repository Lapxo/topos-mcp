bound-lock/1 about="{\n  \"name\": \"@lapxo/topos-mcp\",\n  \"version\": \"0.1.2\",\n  \"private\": true,\n  \"description\": \"A world of MCP servers built on topos: what a server publishes of itself — its tools, the resource it protects and the server that authorizes it — read as a place, never called.\",\n  \"type\": \"module\",\n  \"license\": \"MIT\",\n  \"author\": \"Lapxo\",\n  \"keywords\": [\"topos\", \"world\", \"mcp\"],\n  \"sideEffects\": false,\n  \"engines\": { \"node\": \">=22.15\" },\n  \"exports\": { \".\": { \"types\": \"./dist/index.d.ts\", \"default\": \"./dist/index.js\" }, \"./package.json\": \"./package.json\" },\n  \"files\": [\"dist\", \"README.md\", \"LICENSE\", \"TARGET.bound\"],\n  \"scripts\": { \"build\": \"tsc --build\" },\n  \"dependencies\": { \"@lapxo/topos\": \"0.2.0\" },\n  \"devDependencies\": { \"@types/node\": \"22.20.5\", \"esbuild\": \"0.28.2\", \"typescript\": \"5.9.3\" }\n}\n" at=policy:mcp/document-providers/0.1.2 by=target form=alphabet measure=text role=writes scope=prose/en/documents/manifest shape=package.json value=lock
